<ui:FluentWindow x:Class="IQ99.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:IQ99.App.Pages"
                 xmlns:local="clr-namespace:IQ99.App"
                 mc:Ignorable="d"
                 Title="IQ99" Height="680" Width="1000"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="IQ99" />

        <ui:NavigationView Grid.Row="1" x:Name="NavView"
                           PaneTitle="IQ99"
                           OpenPaneLength="210"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Limpiador"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       TargetPageType="{x:Type pages:CleanerPage}" />
                <ui:NavigationViewItem Content="Espacio en disco"
                                       Icon="{ui:SymbolIcon HardDrive24}"
                                       TargetPageType="{x:Type pages:StoragePage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2" Margin="12,4,12,12" CornerRadius="8" Padding="14,10"
                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}">
            <TextBlock x:Name="TxtStatus" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        </Border>
    </Grid>
</ui:FluentWindow>