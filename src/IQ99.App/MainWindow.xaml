<Window x:Class="IQ99.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IQ99.App"
        mc:Ignorable="d"
        Title="IQ99" Height="620" Width="940"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8"
        Icon="Resources/icon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Resources/icon.png" Width="42" Height="42" Stretch="Uniform" />
                    <TextBlock Text="IQ99" FontSize="28" FontWeight="Bold" Foreground="#1F2937"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock FontSize="12" Foreground="#6B7280"
                           Text="Limpia la caché, archivos temporales y analiza el espacio de tu disco."
                           Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="12,6" VerticalAlignment="Top">
                <TextBlock Foreground="#92400E" FontSize="12">
                    <Run Text="Ejecútala como " /><Bold>Administrador</Bold><Run Text=" para limpiar archivos del sistema" />
                </TextBlock>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Limpiador">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="CleanListView" Grid.Row="0" SelectionMode="Single"
                              BorderBrush="#E5E7EB" Background="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Limpiar" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Categoría" Width="200" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Descripción" Width="330" DisplayMemberBinding="{Binding Description}" />
                                <GridViewColumn Header="Tamaño" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" Foreground="#10B981" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnAnalyze" Content="Analizar" Click="BtnAnalyze_Click" Padding="18,7" />
                        <Button x:Name="BtnClean" Content="Limpiar seleccionados" Click="BtnClean_Click" Padding="18,7" Margin="10,0,0,0" />
                        <TextBlock x:Name="TxtCleanStatus" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#6B7280" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="Todo" Click="BtnSelectAll_Click" Padding="12,7" />
                            <Button Content="Ninguno" Click="BtnSelectNone_Click" Padding="12,7" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="CleanProgress" Grid.Row="2" Height="5" Margin="0,10,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="Espacio en disco">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <ComboBox x:Name="DriveCombo" Width="260" />
                        <Button x:Name="BtnScan" Content="Analizar disco" Click="BtnScan_Click" Padding="18,7" Margin="10,0,0,0" />
                        <Button x:Name="BtnEmptyBin" Content="Vaciar papelera" Click="BtnEmptyBin_Click" Padding="18,7" Margin="10,0,0,0" />
                    </StackPanel>

                    <ListView x:Name="FolderListView" Grid.Row="1"
                              BorderBrush="#E5E7EB" Background="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Carpeta" Width="430">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Tamaño" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" Foreground="#2563EB" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Uso relativo" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding Percent}" Maximum="100" Height="14" Width="130" Foreground="#10B981" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ProgressBar x:Name="FolderProgress" Grid.Row="2" Height="4" Margin="0,12,0,0" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E5E7EB" CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
            <TextBlock x:Name="TxtStatus" Foreground="#374151" FontSize="12" />
        </Border>
    </Grid>
</Window>