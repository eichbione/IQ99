<ui:FluentWindow x:Class="IQ99.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:IQ99.App.Pages"
                 xmlns:local="clr-namespace:IQ99.App"
                 mc:Ignorable="d"
                 Title="IQ99" Height="720" Width="1040"
                 MinWidth="880" MinHeight="620"
                 Icon="pack://application:,,,/Resources/icon.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="IQ99"
                     Icon="pack://application:,,,/Resources/logo.png"
                     ShowMaximize="True" />

        <ui:NavigationView Grid.Row="1" x:Name="NavView"
                           OpenPaneLength="220"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Inicio"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="Limpiador"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       TargetPageType="{x:Type pages:CleanerPage}" />
                <ui:NavigationViewItem Content="Espacio en disco"
                                       Icon="{ui:SymbolIcon HardDrive24}"
                                       TargetPageType="{x:Type pages:StoragePage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2" Margin="12,4,12,10" CornerRadius="8" Padding="14,8"
                VerticalAlignment="Center"
                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon x:Name="StatusIcon" Symbol="Info24" FontSize="14"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                <TextBlock x:Name="TxtStatus" Margin="8,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="Toast"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,16,0"
                Width="360"
                CornerRadius="10"
                Padding="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5"
                Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ui:ThemeResource SystemAccentColorPrimaryBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.4" Color="Black" />
                    </Border.Effect>
                </Border>
                <Grid Grid.Column="1" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="16" Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                    <ui:SymbolIcon x:Name="ToastIcon" Symbol="CheckmarkCircle24" FontSize="18"
                                   Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="2" Margin="0,12,14,12" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ToastMessage" FontSize="12" TextWrapping="Wrap" MaxHeight="44"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>