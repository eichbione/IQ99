<Page x:Class="IQ99.App.Pages.CleanerPage"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
          x:Name="CleanerPageRoot"
          mc:Ignorable="d"
          d:DesignWidth="760" d:DesignHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="CleanListView">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" CornerRadius="8" Padding="16,12"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="11.5"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BtnAnalyze" Content="Analizar" Click="BtnAnalyze_Click" Appearance="Primary"
                       MinWidth="110" Height="38" Padding="18,0" />
            <ui:Button x:Name="BtnClean" Content="Limpiar seleccionados" Click="BtnClean_Click" Appearance="Danger"
                       MinWidth="140" Height="38" Padding="18,0" HorizontalAlignment="Left"
                       Margin="10,0,0,0" />
            <TextBlock x:Name="TxtCleanStatus" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                       Text="Selecciona categorías y pulsa Limpiar." FontSize="12" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Todo" Click="BtnSelectAll_Click" MinWidth="70" Height="38" Padding="16,0" />
                <ui:Button Content="Ninguno" Click="BtnSelectNone_Click" Margin="8,0,0,0" MinWidth="70" Height="38" Padding="16,0" />
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="CleanProgress" Grid.Row="2" Height="4" Margin="0,12,0,0" />
    </Grid>
</Page>