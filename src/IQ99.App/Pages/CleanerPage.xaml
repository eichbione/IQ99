<Page x:Class="IQ99.App.Pages.CleanerPage"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
          x:Name="CleanerPageRoot"
          mc:Ignorable="d"
          d:DesignWidth="760" d:DesignHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <ItemsControl x:Name="CleanListView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="8" Padding="14,12"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,0,0" />
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8"
                                            Background="{Binding TintHex, Converter={StaticResource BrushConv}}"
                                            VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding IconKey, Converter={StaticResource SymbolConv}}"
                                                       FontSize="17" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="4,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                        <StackPanel x:Name="NoticeRow" Orientation="Horizontal" Margin="0,3,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CloseNotice}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ui:SymbolIcon Symbol="Info24" FontSize="12"
                                                           Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                           VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CloseNotice}" FontSize="11.5" Margin="5,0,0,0"
                                                       Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Card Margin="0,6,0,2" Padding="18,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Últimas limpiezas" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" x:Name="BtnClearHistory" Content="Vaciar historial"
                                       Click="BtnClearHistory_Click" MinWidth="110" Height="30"
                                       Padding="12,0" FontSize="12" />
                        </Grid>
                        <TextBlock x:Name="TxtHistoryEmpty" Text="Aún no hay limpiezas registradas."
                                   FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl x:Name="HistoryList" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,8" Margin="0,3"
                                            Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding BytesFreed, Converter={StaticResource BytesConv}, FallbackValue='0 B'}"
                                                       FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"
                                                       Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="12"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                <Run Text="{Binding FilesCount, Mode=OneWay}" /><Run Text=" elementos" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BtnAnalyze" Content="Analizar" Click="BtnAnalyze_Click" Appearance="Primary"
                       MinWidth="110" Height="38" Padding="18,0" />
            <ui:Button x:Name="BtnClean" Content="Limpiar seleccionados" Click="BtnClean_Click" Appearance="Danger"
                       MinWidth="140" Height="38" Padding="18,0" HorizontalAlignment="Left"
                       Margin="10,0,0,0" />
            <TextBlock x:Name="TxtCleanStatus" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                       Text="Selecciona categorías y pulsa Limpiar." FontSize="12" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Todo" Click="BtnSelectAll_Click" MinWidth="70" Height="38" Padding="16,0" />
                <ui:Button Content="Ninguno" Click="BtnSelectNone_Click" Margin="8,0,0,0" MinWidth="70" Height="38" Padding="16,0" />
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="CleanProgress" Grid.Row="2" Height="4" Margin="0,12,0,0" />

        <Border x:Name="CleanDoneOverlay" Grid.RowSpan="3" Background="#CC101010"
                Visibility="Collapsed" MouseLeftButtonUp="CleanDoneOverlay_MouseLeftButtonUp">
            <ui:Card Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,26">
                <StackPanel>
                    <Border Width="66" Height="66" CornerRadius="33" HorizontalAlignment="Center"
                            Background="{ui:ThemeResource SystemAccentColorPrimaryBrush}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="34" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="¡Limpieza completada!" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="TxtDoneBytes" Text="0 B" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                    <TextBlock x:Name="TxtDoneCount" Text="archivos o carpetas eliminados" FontSize="12.5"
                               HorizontalAlignment="Center"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    <ui:Button Content="Listo" Appearance="Primary" Width="170" Height="40" Margin="0,20,0,0"
                               HorizontalAlignment="Center" Click="BtnDoneClose_Click" />
                </StackPanel>
            </ui:Card>
        </Border>
    </Grid>
</Page>