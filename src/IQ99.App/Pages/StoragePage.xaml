<Page x:Class="IQ99.App.Pages.StoragePage"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
          mc:Ignorable="d"
          d:DesignWidth="760" d:DesignHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DriveCombo" Width="300" Height="38" VerticalContentAlignment="Center" />
            <ui:Button x:Name="BtnScan" Content="Analizar disco" Click="BtnScan_Click" Margin="10,0,0,0"
                       Appearance="Primary" MinWidth="120" Height="38" Padding="16,0" />
            <ui:Button x:Name="BtnEmptyBin" Content="Vaciar papelera" Click="BtnEmptyBin_Click" Margin="10,0,0,0"
                       MinWidth="120" Height="38" Padding="16,0" />
            <TextBlock Grid.Column="3" x:Name="TxtDriveStatus" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="FolderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" CornerRadius="8" Padding="16,12"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                           FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" TextAlignment="Right"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                           Margin="8,0,0,0" />
                                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" />
                                    <TextBlock Text="{Binding Percent, StringFormat={}{0:F0} %}" FontSize="10.5"
                                               HorizontalAlignment="Right" Margin="0,3,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressBar x:Name="FolderProgress" Grid.Row="2" Height="4" Margin="0,8,0,0" />
    </Grid>
</Page>