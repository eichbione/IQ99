<Page x:Class="IQ99.App.Pages.DashboardPage"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
          mc:Ignorable="d"
          d:DesignWidth="760" d:DesignHeight="560">
    <Grid Margin="32,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Hola, tu PC te espera" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Revisa el estado del equipo y libera espacio con un clic."
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <ui:ProgressRing x:Name="HealthRing" Width="120" Height="120"
                                             Progress="0" IsIndeterminate="True" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtScore" Text="--" FontSize="30" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="TxtScoreUnit" Text="% salud" FontSize="11"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Salud del PC" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtHealthStatus" Text="Analizando el equipo..."
                                       FontSize="13" Margin="0,4,0,0"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtReclaimable" Text="" FontSize="15" Margin="0,14,0,0" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" x:Name="BtnCleanNow" Click="BtnCleanNow_Click"
                                           Appearance="Primary" Height="40"
                                           Content="Limpiar ahora" />
                                <ui:Button Grid.Column="2" x:Name="BtnAnalyzeNow" Click="BtnAnalyzeNow_Click"
                                           Height="40"
                                           Content="Analizar" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="Qué puedes liberar" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,8" Margin="0,2"
                                            Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Estado rápido" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="Categorías" FontSize="11"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtCategories" Text="0" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Con contenido" FontSize="11"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtWithContent" Text="0" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Recomendaciones" FontSize="11" Margin="0,4,0,6"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.RowSpan="1" x:Name="TxtRecommendation"
                                   Grid.Column="0" Grid.ColumnSpan="2" Text="Analiza para ver recomendaciones."
                                   FontSize="12.5" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>